FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN dpkg --add-architecture i386 \
    && apt-get update \
    && apt-get install --no-install-recommends -y \
       wine wine32:i386 wine64 winbind xvfb xauth cabextract p7zip-full \
       python3 make openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN install -d -m 0755 -o 1000 -g 1000 /opt/builder
COPY --chown=1000:1000 --chmod=0644 build.py extract_sdk.py /opt/builder/
USER 1000:1000
ENV HOME=/build/home WINEPREFIX=/build/wine WINEARCH=win32 WINEDEBUG=-all
WORKDIR /build
CMD ["sleep", "infinity"]
